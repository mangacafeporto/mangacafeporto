---
import { type Locale, getTranslations } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
---

<section id="pricing" class="pricing" aria-labelledby="pricing-title">
  <div class="pricing__inner container">
    <!-- Scattered illustrations -->
    <img src="/images/illustrations/onigiri.svg" alt="" class="pricing__deco pricing__deco--1" aria-hidden="true" width="36" height="36" />
    <img src="/images/illustrations/coffee-mug.svg" alt="" class="pricing__deco pricing__deco--2" aria-hidden="true" width="28" height="28" />
    <div class="pricing__header reveal">
      <h2 id="pricing-title" class="pricing__title">{t.pricing.title}</h2>
      <span class="jp-accent">{t.pricing.jp}</span>
      <img src="/images/illustrations/sake-cups.svg" alt="" class="pricing__illustration" aria-hidden="true" width="44" height="44" />
      <span class="pricing__note">{t.pricing.paid_at_cafe}</span>
    </div>

    <!-- Drop-in pricing -->
    <div class="pricing__dropin reveal">
      <div class="pricing__card pricing__card--dropin">
        <h3 class="pricing__card-title">{t.pricing.drop_in_title}</h3>
        <div class="pricing__card-price">{t.pricing.per_hour}</div>
        <ul class="pricing__card-details">
          <li>{t.pricing.pack_3h}</li>
          <li>{t.pricing.extension}</li>
        </ul>
      </div>
    </div>

    <!-- Membership tiers -->
    <div class="pricing__tiers">
      <div class="pricing__card pricing__card--nomad reveal">
        <h3 class="pricing__card-title">{t.pricing.nomad_title}</h3>
        <p class="pricing__card-desc">{t.pricing.nomad_desc}</p>
        <div class="pricing__card-price pricing__card-price--large">{t.pricing.nomad_price}</div>
        <ul class="pricing__card-details">
          <li>{t.pricing.nomad_perk}</li>
        </ul>
      </div>

      <div class="pricing__card pricing__card--vip reveal">
        <h3 class="pricing__card-title">{t.pricing.vip_title}</h3>
        <p class="pricing__card-desc">{t.pricing.vip_desc}</p>
        <div class="pricing__card-price pricing__card-price--large">{t.pricing.vip_price}</div>
        <ul class="pricing__card-details">
          <li>{t.pricing.vip_perk}</li>
        </ul>
      </div>
    </div>

    <!-- Shared footnote -->
    <div class="pricing__footnote reveal">
      <hr class="pricing__footnote-line" />
      <p class="pricing__footnote-text">{t.pricing.includes}</p>
    </div>
  </div>
</section>

<style>
  .pricing {
    border-top: var(--border-thin) solid var(--color-crimson);
    padding-top: var(--space-md);
  }

  .pricing__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    position: relative;
  }

  .pricing__deco {
    position: absolute;
    opacity: 0.15;
    pointer-events: none;
    display: none;
  }

  @media (min-width: 48rem) {
    .pricing__deco { display: block; }
    .pricing__deco--1 { top: 40%; right: 2%; transform: rotate(12deg); }
    .pricing__deco--2 { bottom: 15%; left: 60%; transform: rotate(-8deg); }
  }

  .pricing__header {
    display: flex;
    align-items: baseline;
    gap: var(--space-md);
  }

  .pricing__title {
    color: var(--color-crimson);
  }

  .pricing__illustration {
    opacity: 0.3;
    transform: rotate(5deg);
  }

  /* Drop-in card */
  .pricing__dropin {
    max-width: 28rem;
  }

  .pricing__card {
    padding: var(--space-lg);
    border: var(--border-medium) solid var(--color-crimson);
    position: relative;
  }

  .pricing__card--dropin {
    border-style: dashed;
  }

  .pricing__card-title {
    font-size: var(--text-xl);
    margin-bottom: var(--space-sm);
  }

  .pricing__card-desc {
    font-style: italic;
    color: var(--color-text-light);
    margin-bottom: var(--space-md);
  }

  .pricing__card-price {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    color: var(--color-crimson);
    margin-bottom: var(--space-md);
  }

  .pricing__card-price--large {
    font-size: var(--text-3xl);
  }

  .pricing__card-details {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .pricing__card-details li {
    padding-left: 1.2em;
    position: relative;
  }

  .pricing__card-details li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--color-crimson);
  }

  /* Shared footnote */
  .pricing__footnote {
    max-width: 40rem;
  }

  .pricing__footnote-line {
    border: none;
    border-top: var(--border-thin) solid var(--color-text-muted);
    margin-bottom: var(--space-sm);
  }

  .pricing__footnote-text {
    font-size: var(--text-sm);
    color: var(--color-text-light);
    font-style: italic;
  }

  /* Membership tiers grid */
  .pricing__tiers {
    display: grid;
    gap: var(--space-lg);
  }

  @media (min-width: 48rem) {
    .pricing__tiers {
      grid-template-columns: 1fr 1fr;
    }

    /* Slight offset for zine feel */
    .pricing__card--vip {
      transform: translateY(1.5rem);
    }
  }

  .pricing__card--vip {
    border-color: var(--color-crimson);
    border-width: var(--border-thick);
  }

  .pricing__note {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    font-style: italic;
    margin-left: auto;
  }
</style>
