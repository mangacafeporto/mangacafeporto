---

<div
  class='scatter'
  aria-hidden='true'>
  {
    illustrations.map(item => (
      <img
        src={`/images/illustrations/${item.src}.svg`}
        alt=''
        class='scatter-item'
        width={item.s}
        height={item.s}
        style={`top:${item.top}%;${item.left != null ? `left:${item.left}%` : `right:${item.right}%`};transform:rotate(${item.r}deg)`}
      />
    ))
  }
</div>

<style is:global>
  .scatter {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    z-index: -1;
    pointer-events: none;
    display: none;
  }

  .scatter-item {
    position: absolute;
    opacity: 0.1;
  }

  @media (min-width: 48rem) {
    .scatter {
      display: block;
    }
  }
</style>

<script>
  function syncScatterHeight() {
    const scatter = document.querySelector('.scatter') as HTMLElement;
    if (scatter) {
      scatter.style.height = document.documentElement.scrollHeight + 'px';
    }
  }

  function initScatter() {
    syncScatterHeight();
    window.addEventListener('resize', syncScatterHeight);
    const ro = new ResizeObserver(() => syncScatterHeight());
    ro.observe(document.body);
  }

  initScatter();
  document.addEventListener('astro:after-swap', initScatter);
</script>
