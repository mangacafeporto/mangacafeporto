---
import { type Locale, getTranslations } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);

const mapSrc =
  'https://maps.google.com/maps?width=600&height=400&hl=en&q=Manga%20Caf%C3%A9%20Porto&t=&z=15&ie=UTF8&iwloc=B&output=embed';
---

<section
  id='contact'
  class='contact'
  aria-labelledby='contact-title'>
  <div class='contact__inner container'>
    <div class='contact__header reveal'>
      <h2
        id='contact-title'
        class='contact__title'
        >{t.contact.title}</h2
      >
      <span class='jp-accent'>{t.contact.jp}</span>
    </div>

    <div class='contact__content'>
      <div class='contact__info reveal'>
        <address class='contact__address'>
          {t.contact.address}
        </address>

        <div class='contact__social'>
          <a
            href='https://www.instagram.com/mangacafe_porto'
            target='_blank'
            rel='noopener noreferrer'
            class='link-animated'>
            Instagram
          </a>
          <a
            href='https://www.facebook.com/people/MANGA-CAFE-PORTO'
            target='_blank'
            rel='noopener noreferrer'
            class='link-animated'>
            Facebook
          </a>
        </div>
      </div>

      <div class='contact__map reveal'>
        <iframe
          src={mapSrc}
          width='100%'
          height='350'
          style='border:0;'
          allowfullscreen=''
          loading='lazy'
          referrerpolicy='no-referrer-when-downgrade'
          title={locale === 'pt' ? 'Mapa — Manga Café Porto' : 'Map — Manga Café Porto'}
        ></iframe>
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    border-top: var(--border-thin) solid var(--color-cobalt);
  }

  .contact__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    position: relative;
  }

  .contact__header {
    display: flex;
    align-items: baseline;
    gap: var(--space-md);
  }

  .contact__title {
    color: var(--color-crimson);
  }

  .contact__content {
    display: grid;
    gap: var(--space-xl);
  }

  @media (min-width: 48rem) {
    .contact__content {
      grid-template-columns: 1fr 1.5fr;
      align-items: start;
    }
  }

  .contact__info {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .contact__address {
    font-style: normal;
    font-size: var(--text-lg);
    line-height: 1.6;
  }

  .contact__social {
    display: flex;
    gap: var(--space-lg);
  }

  .contact__social a {
    font-family: var(--font-display);
    font-size: var(--text-base);
    color: var(--color-crimson);
  }

  .contact__map {
    border: var(--border-medium) solid var(--color-crimson);
    overflow: hidden;
    transform: rotate(-0.5deg);
  }

  .contact__map iframe {
    display: block;
    width: 100%;
    max-width: 100%;
  }
</style>
