---
import { type Locale, getTranslations } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
---

<section id="events" class="events" aria-labelledby="events-title">
  <div class="events__inner container">
    <!-- Scattered illustrations -->
    <img src="/images/illustrations/sake-cups.svg" alt="" class="events__deco events__deco--1" aria-hidden="true" width="32" height="32" />
    <img src="/images/illustrations/manga-book.svg" alt="" class="events__deco events__deco--2" aria-hidden="true" width="38" height="38" />
    <div class="events__header reveal">
      <h2 id="events-title" class="events__title">{t.events.title}</h2>
      <span class="jp-accent">{t.events.jp}</span>
      <img src="/images/illustrations/onigiri.svg" alt="" class="events__illustration" aria-hidden="true" width="44" height="44" />
    </div>

    <p class="events__blurb reveal">{t.events.blurb}</p>

    <!-- Social feed embeds -->
    <div class="events__feeds reveal">
      <div class="events__feed">
        <div class="events__feed-card">
          <div class="events__feed-header">
            <span class="events__feed-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
              </svg>
            </span>
            <span class="events__feed-name">@mangacafe_porto</span>
          </div>

          <!-- Instagram embed widget -->
          <div class="events__feed-embed">
            <iframe
              src="https://www.instagram.com/mangacafe_porto/embed"
              width="100%"
              height="480"
              frameborder="0"
              scrolling="no"
              allowtransparency="true"
              loading="lazy"
              title="Instagram — @mangacafe_porto"
            ></iframe>
          </div>

          <a
            href="https://www.instagram.com/mangacafe_porto"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-secondary events__feed-link"
          >
            {t.events.follow_cta}
          </a>
        </div>
      </div>

      <div class="events__feed">
        <div class="events__feed-card">
          <div class="events__feed-header">
            <span class="events__feed-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
            </span>
            <span class="events__feed-name">Manga Café Porto</span>
          </div>

          <div class="events__feed-placeholder">
            <p class="events__feed-placeholder-text">
              {locale === 'pt' ? 'Acompanha-nos no Facebook para novidades e eventos.' : 'Follow us on Facebook for news and events.'}
            </p>
          </div>

          <a
            href="https://www.facebook.com/people/MANGA-CAFE-PORTO/61578631384335/"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-secondary events__feed-link"
          >
            {t.events.follow_cta}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .events {
    border-top: var(--border-thin) solid var(--color-cobalt);
  }

  .events__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    position: relative;
  }

  .events__deco {
    position: absolute;
    opacity: 0.15;
    pointer-events: none;
    display: none;
  }

  @media (min-width: 48rem) {
    .events__deco { display: block; }
    .events__deco--1 { bottom: 30%; right: 2%; transform: rotate(-14deg); }
    .events__deco--2 { top: 45%; left: -1%; transform: rotate(8deg); }
  }

  .events__header {
    display: flex;
    align-items: baseline;
    gap: var(--space-md);
  }

  .events__title {
    color: var(--color-crimson);
  }

  .events__illustration {
    opacity: 0.3;
    transform: rotate(-6deg);
    margin-left: auto;
  }

  .events__blurb {
    font-size: var(--text-lg);
    color: var(--color-text-light);
    max-width: 55ch;
    line-height: 1.7;
  }

  .events__feeds {
    display: grid;
    gap: var(--space-lg);
  }

  @media (min-width: 48rem) {
    .events__feeds {
      grid-template-columns: 1fr 1fr;
    }
  }

  .events__feed-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    padding: var(--space-md);
    border: var(--border-thin) solid var(--color-text-muted);
    overflow: hidden;
  }

  .events__feed-header {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    color: var(--color-text);
  }

  .events__feed-icon {
    opacity: 0.6;
    flex-shrink: 0;
  }

  .events__feed-name {
    font-family: var(--font-display);
    font-size: var(--text-sm);
  }

  .events__feed-embed {
    width: 100%;
    overflow: hidden;
    border-radius: 2px;
    border: var(--border-thin) solid var(--color-text-muted);
    padding: var(--space-xs);
  }

  .events__feed-embed iframe {
    display: block;
    width: 100%;
    max-width: 100%;
    border: none;
  }

  .events__feed-link {
    font-size: var(--text-xs);
    align-self: center;
  }

  .events__feed-embed iframe {
    height: min(480px, 70vh);
  }

  .events__feed-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    height: min(480px, 70vh);
    padding: var(--space-lg);
    background: var(--color-cream-dark);
    border: var(--border-thin) dashed var(--color-text-muted);
  }

  .events__feed-placeholder-text {
    font-style: italic;
    color: var(--color-text-light);
    text-align: center;
    max-width: 24ch;
    line-height: 1.6;
  }
</style>
