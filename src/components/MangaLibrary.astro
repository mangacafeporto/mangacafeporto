---
import { type Locale, getTranslations } from '../i18n';
import SectionHeader from './SectionHeader.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
---

<section
  id='library'
  class='library'
  aria-labelledby='library-title'>
  <div class='library-inner container'>
    <SectionHeader
      id='library-title'
      title={t.library.title}
      jp={t.library.jp}
    />

    <p class='library-desc reveal'>{t.library.description}</p>

    <div class='library-highlights reveal'>
      {
        t.library.highlights.map((title: string, i: number) => (
          <span
            class='library-manga-title'
            style={`--rotate: ${(i % 2 === 0 ? -1 : 1) * (1 + i * 0.5)}deg`}>
            {title}
          </span>
        ))
      }
    </div>

    <div class='library-photos reveal'>
      <div class='library-photo library-photo--1'>
        <img
          src='/images/shelves-1.jpg'
          alt={t.library.shelf_alt}
          loading='lazy'
          decoding='async'
        />
      </div>
      <div class='library-photo library-photo--2'>
        <img
          src='/images/shelves-2.jpg'
          alt={t.library.volumes_alt}
          loading='lazy'
          decoding='async'
        />
      </div>
    </div>
  </div>
</section>

<style>
  .library {
    border-top: var(--border-thin) solid var(--color-crimson);
    overflow: hidden;
  }

  .library-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    position: relative;
  }

  .library-desc {
    font-size: var(--text-lg);
    color: var(--color-text-light);
    max-width: 50ch;
    line-height: 1.7;
  }

  .library-highlights {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    padding-block: var(--space-md);
  }

  .library-manga-title {
    display: inline-block;
    padding: var(--space-xs) var(--space-md);
    border: var(--border-thin) solid var(--color-crimson);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    color: var(--color-crimson);
    transform: rotate(var(--rotate, 0deg));
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .library-manga-title:nth-child(even) {
    border-color: var(--color-cobalt);
    color: var(--color-cobalt);
  }

  .library-manga-title:hover {
    transform: rotate(0deg) scale(1.05);
  }

  .library-photos {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
    overflow: visible;
    padding: var(--space-md);
  }

  @media (min-width: 40rem) {
    .library-photos {
      grid-template-columns: 1fr 1fr;
    }
  }

  .library-photo {
    aspect-ratio: 4 / 3;
    border: var(--border-thin) solid var(--color-text-muted);
    overflow: hidden;
  }

  .library-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .library-photo--1 {
    transform: rotate(-1deg);
  }

  .library-photo--2 {
    transform: rotate(1.5deg);
  }

  .library-photo {
    transition:
      transform var(--duration-normal) var(--ease-out),
      box-shadow var(--duration-normal) var(--ease-out),
      border-color var(--duration-normal) var(--ease-out);
    cursor: pointer;
  }

  @media (hover: hover) {
    .library-photo:hover {
      transform: rotate(0deg) scale(1.15);
      z-index: 20;
      border-color: var(--color-cobalt);
      border-width: var(--border-thick);
      box-shadow: 4px 6px 20px rgba(42, 33, 24, 0.35);
    }
  }

  .library-photo:active {
    transform: rotate(0deg) scale(1.1);
    z-index: 20;
    border-color: var(--color-cobalt);
    border-width: var(--border-thick);
    box-shadow: 4px 6px 20px rgba(42, 33, 24, 0.35);
  }
</style>
