---
import { type Locale, getTranslations } from '../i18n';
import SectionHeader from './SectionHeader.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);

const galleryPhotos = [
  { src: '/images/space-8.jpg', rotate: -2.5, large: true },
  { src: '/images/space-7.jpg', rotate: 3.0, large: false },
  { src: '/images/space-3.jpg', rotate: -1.5, large: false },
  { src: '/images/space-4.jpg', rotate: 2.5, large: false },
  { src: '/images/space-5.jpg', rotate: -3.0, large: false },
  { src: '/images/space-6.jpg', rotate: 1.5, large: true },
  { src: '/images/space-9.jpg', rotate: -2.0, large: false },
  { src: '/images/space-1.jpg', rotate: 3.5, large: false },
  { src: '/images/space-2.jpg', rotate: -1.0, large: false },
];
---

<section
  id='gallery'
  class='gallery'
  aria-labelledby='gallery-title'>
  <div class='gallery-inner container'>
    <SectionHeader
      id='gallery-title'
      title={t.gallery.title}
      jp={t.gallery.jp}
    />

    <div class='gallery-grid'>
      {
        galleryPhotos.map(photo => (
          <div
            class:list={['gallery-item', photo.large && 'gallery-item--large', 'reveal']}
            style={`--rotate: ${photo.rotate}deg`}>
            <div class='gallery-photo'>
              <img
                src={photo.src}
                alt='Manga Café Porto'
                loading='lazy'
                decoding='async'
              />
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .gallery {
    border-top: var(--border-thin) solid var(--color-crimson);
    padding-top: var(--space-md);
  }

  .gallery-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    position: relative;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-sm);
  }

  .gallery-item {
    transform: rotate(var(--rotate, 0deg));
    transition:
      transform var(--duration-normal) var(--ease-out),
      box-shadow var(--duration-normal) var(--ease-out);
    cursor: pointer;
    position: relative;
  }

  @media (hover: hover) {
    .gallery-item:hover {
      transform: rotate(0deg) scale(1.3);
      z-index: 20;
    }

    .gallery-item:hover .gallery-photo {
      border-color: var(--color-cobalt);
      border-width: var(--border-thick);
      box-shadow: 4px 6px 20px rgba(42, 33, 24, 0.35);
      aspect-ratio: auto;
    }
  }

  .gallery-item:active {
    transform: rotate(0deg) scale(1.05);
    z-index: 20;
  }

  .gallery-item:active .gallery-photo {
    border-color: var(--color-cobalt);
    border-width: var(--border-thick);
    box-shadow: 4px 6px 20px rgba(42, 33, 24, 0.35);
  }

  .gallery-photo {
    aspect-ratio: 1;
    border: var(--border-thin) solid var(--color-text-muted);
    overflow: hidden;
    box-shadow: 2px 3px 8px rgba(42, 33, 24, 0.12);
    transition: box-shadow var(--duration-normal) var(--ease-out);
    position: relative;
    background-color: var(--color-cream);
  }

  .gallery-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .gallery-item--large .gallery-photo {
    aspect-ratio: 16 / 10;
  }

  .gallery-item--large {
    grid-column: span 2;
  }

  @media (min-width: 40rem) {
    .gallery-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .gallery-grid {
      display: block;
      position: relative;
      height: clamp(380px, calc(100vh - 12rem), 650px);
    }

    .gallery-item {
      position: absolute;
      margin: 0;
    }

    .gallery-item--large {
      grid-column: unset;
    }

    .gallery-photo,
    .gallery-item--large .gallery-photo {
      width: 100%;
      height: 100%;
      aspect-ratio: unset;
    }

    .gallery-item:nth-child(1) {
      top: 0%;
      left: 0%;
      width: 28%;
      height: 52%;
      z-index: 2;
    }
    .gallery-item:nth-child(2) {
      top: 0%;
      left: 26%;
      width: 42%;
      height: 38%;
      z-index: 1;
    }
    .gallery-item:nth-child(3) {
      top: 0%;
      left: 70%;
      width: 30%;
      height: 52%;
      z-index: 3;
    }
    .gallery-item:nth-child(4) {
      top: 35%;
      left: 24%;
      width: 25%;
      height: 35%;
      z-index: 4;
    }
    .gallery-item:nth-child(5) {
      top: 35%;
      left: 47%;
      width: 25%;
      height: 35%;
      z-index: 2;
    }
    .gallery-item:nth-child(6) {
      top: 50%;
      left: -1%;
      width: 28%;
      height: 38%;
      z-index: 3;
    }
    .gallery-item:nth-child(7) {
      top: 50%;
      left: 73%;
      width: 28%;
      height: 38%;
      z-index: 1;
    }
    .gallery-item:nth-child(8) {
      top: 70%;
      left: 3%;
      width: 45%;
      height: 30%;
      z-index: 5;
    }
    .gallery-item:nth-child(9) {
      top: 70%;
      left: 50%;
      width: 48%;
      height: 30%;
      z-index: 4;
    }

    @media (hover: hover) {
      .gallery-item:hover {
        z-index: 20;
      }
    }
  }
</style>
