---
import { type Locale, getTranslations } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);

// Gallery photos
const galleryPhotos = [
  { src: '/images/space-1.jpg', rotate: -2.5, large: true },
  { src: '/images/space-2.jpg', rotate: 3.0,  large: false },
  { src: '/images/space-3.jpg', rotate: -1.5, large: false },
  { src: '/images/space-4.jpg', rotate: 2.5,  large: false },
  { src: '/images/space-5.jpg', rotate: -3.0, large: false },
  { src: '/images/space-6.jpg', rotate: 1.5,  large: true },
  { src: '/images/space-7.jpg', rotate: -2.0, large: false },
  { src: '/images/space-8.jpg', rotate: 3.5,  large: false },
  { src: '/images/space-9.jpg', rotate: -1.0, large: false },
];
---

<section id="gallery" class="gallery" aria-labelledby="gallery-title">
  <div class="gallery__inner container">
    <!-- Scattered illustrations -->
    <img src="/images/illustrations/sake-bottle.svg" alt="" class="gallery__deco gallery__deco--1" aria-hidden="true" width="28" height="28" />
    <img src="/images/illustrations/manga-book.svg" alt="" class="gallery__deco gallery__deco--2" aria-hidden="true" width="34" height="34" />
    <div class="gallery__header reveal">
      <h2 id="gallery-title" class="gallery__title">{t.gallery.title}</h2>
      <span class="jp-accent">{t.gallery.jp}</span>
      <img src="/images/illustrations/coffee-mug.svg" alt="" class="gallery__illustration" aria-hidden="true" width="44" height="44" />
    </div>

    <div class="gallery__grid">
      {galleryPhotos.map((photo) => (
        <div
          class:list={[
            'gallery__item',
            photo.large && 'gallery__item--large',
            'reveal',
          ]}
          style={`--rotate: ${photo.rotate}deg`}
        >
          <div class="gallery__photo">
            <img
              src={photo.src}
              alt="Manga Café Porto"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .gallery {
    border-top: var(--border-thin) solid var(--color-crimson);
    overflow: hidden;
    padding-top: var(--space-md);
  }

  .gallery__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    position: relative;
  }

  .gallery__deco {
    position: absolute;
    opacity: 0.15;
    pointer-events: none;
    display: none;
  }

  @media (min-width: 48rem) {
    .gallery__deco { display: block; }
    .gallery__deco--1 { top: 50%; right: 1%; transform: rotate(-18deg); }
    .gallery__deco--2 { bottom: 10%; left: 2%; transform: rotate(14deg); }
  }

  .gallery__header {
    display: flex;
    align-items: baseline;
    gap: var(--space-md);
  }

  .gallery__title {
    color: var(--color-crimson);
  }

  .gallery__illustration {
    opacity: 0.3;
    transform: rotate(4deg);
    margin-left: auto;
  }

  /* Mobile: 2-col grid */
  .gallery__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-sm);
  }

  .gallery__item {
    transform: rotate(var(--rotate, 0deg));
    transition: transform var(--duration-normal) var(--ease-out),
                box-shadow var(--duration-normal) var(--ease-out);
    cursor: pointer;
    position: relative;
  }

  @media (hover: hover) {
    .gallery__item:hover {
      transform: rotate(0deg) scale(1.15);
      z-index: 20;
    }

    .gallery__item:hover .gallery__photo {
      border-color: var(--color-text);
      border-width: 2px;
      box-shadow: 4px 6px 20px rgba(42, 33, 24, 0.35);
    }
  }

  /* Touch tap feedback */
  .gallery__item:active {
    transform: rotate(0deg) scale(1.1);
    z-index: 20;
  }

  .gallery__item:active .gallery__photo {
    border-color: var(--color-text);
    box-shadow: 4px 6px 20px rgba(42, 33, 24, 0.35);
  }

  .gallery__photo {
    aspect-ratio: 1;
    border: var(--border-thin) solid var(--color-text-muted);
    overflow: hidden;
    box-shadow: 2px 3px 8px rgba(42, 33, 24, 0.12);
    transition: box-shadow var(--duration-normal) var(--ease-out);
  }

  .gallery__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .gallery__item--large .gallery__photo {
    aspect-ratio: 16 / 10;
  }

  .gallery__item--large {
    grid-column: span 2;
  }

  /* Tablet: 3-col */
  @media (min-width: 40rem) {
    .gallery__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Desktop: scattered collage with overlaps */
  @media (min-width: 64rem) {
    .gallery__grid {
      display: block;
      position: relative;
      height: clamp(380px, calc(100vh - 12rem), 650px);
    }

    .gallery__item {
      position: absolute;
      margin: 0;
    }

    .gallery__item--large {
      grid-column: unset;
    }

    .gallery__photo,
    .gallery__item--large .gallery__photo {
      width: 100%;
      height: 100%;
      aspect-ratio: unset;
    }

    /* Mosaic-inspired scattered positions — photos overlap at edges */
    .gallery__item:nth-child(1) { top: 0%; left: 0%;  width: 28%; height: 52%; z-index: 2; }
    .gallery__item:nth-child(2) { top: 0%; left: 26%; width: 42%; height: 38%; z-index: 1; }
    .gallery__item:nth-child(3) { top: 0%; left: 70%; width: 30%; height: 52%; z-index: 3; }
    .gallery__item:nth-child(4) { top: 35%; left: 24%; width: 25%; height: 35%; z-index: 4; }
    .gallery__item:nth-child(5) { top: 35%; left: 47%; width: 25%; height: 35%; z-index: 2; }
    .gallery__item:nth-child(6) { top: 50%; left: -1%; width: 28%; height: 38%; z-index: 3; }
    .gallery__item:nth-child(7) { top: 50%; left: 73%; width: 28%; height: 38%; z-index: 1; }
    .gallery__item:nth-child(8) { top: 70%; left: 3%;  width: 45%; height: 30%; z-index: 5; }
    .gallery__item:nth-child(9) { top: 70%; left: 50%; width: 48%; height: 30%; z-index: 4; }

    /* Must come after nth-child rules to win specificity */
    @media (hover: hover) {
      .gallery__item:hover {
        z-index: 20;
      }
    }
  }
</style>
