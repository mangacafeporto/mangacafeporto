---
import '../styles/global.css';
import { type Locale, getTranslations, getAlternateLocale, getLocalePath } from '../i18n';
import { ClientRouter } from 'astro:transitions';
import Navigation from '../components/Navigation.astro';
import LangToggle from '../components/LangToggle.astro';
import Footer from '../components/Footer.astro';
import ScatteredIllustrations from '../components/ScatteredIllustrations.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const altLocale = getAlternateLocale(locale);
const altUrl = getLocalePath(altLocale);
---

<!DOCTYPE html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{t.site.title}</title>
    <meta name="description" content={t.site.og_description} />

    <!-- Open Graph -->
    <meta property="og:title" content={t.site.title} />
    <meta property="og:description" content={t.site.og_description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={locale === 'pt' ? 'pt_PT' : 'en_US'} />
    <meta property="og:site_name" content="Manga Café Porto" />

    <!-- Alternate language -->
    <link rel="alternate" hreflang={altLocale} href={altUrl} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Alfa+Slab+One&family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Shippori+Mincho:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Favicon -->
    <link rel="icon" type="image/png" sizes="180x180" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />

    <!-- Prevent Astro's scroll restoration on refresh (runs before router module) -->
    <script is:inline>
      if (history.state && history.state.scrollX != null) {
        history.replaceState({ ...history.state, scrollX: 0, scrollY: 0 }, '');
      }
      if (location.hash) {
        document.addEventListener('DOMContentLoaded', function() {
          var el = document.querySelector(location.hash);
          if (el) el.scrollIntoView();
        });
      }
    </script>

    <ClientRouter />
  </head>
  <body>
    <div class="page">
      <a href="#main" class="sr-only">Skip to content</a>
      <LangToggle locale={locale} altLocale={altLocale} altUrl={altUrl} />
      <Navigation locale={locale} />

      <main id="main">
        <slot />
      </main>

      <Footer locale={locale} />

      <ScatteredIllustrations />
    </div>

    <!-- Scroll reveal observer -->
    <script>
      function initReveal() {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.1, rootMargin: '0px 0px -50px 0px' }
        );
        document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
      }

      initReveal();
      document.addEventListener('astro:after-swap', initReveal);
    </script>

    <!-- Preserve scroll position on language switch -->
    <script>
      import { navigate } from 'astro:transitions/client';

      function attachLangScrollSave() {
        document.querySelectorAll('.lang-option:not(.active)').forEach((link) => {
          link.addEventListener('click', (e) => {
            e.preventDefault();
            const baseHref = (link as HTMLAnchorElement).href.split('#')[0];
            const docHeight = document.documentElement.scrollHeight;
            const ratio = docHeight > window.innerHeight
              ? window.scrollY / (docHeight - window.innerHeight)
              : 0;
            // Find the current active section for the URL hash
            const activeTab = document.querySelector('.book-tab.active');
            const sectionId = activeTab?.getAttribute('data-section') || '';
            sessionStorage.setItem('langSwitchRatio', String(ratio));
            if (sectionId) sessionStorage.setItem('langSwitchHash', sectionId);
            // Navigate without hash to avoid Astro's anchor scrolling
            navigate(baseHref);
          });
        });
      }

      attachLangScrollSave();
      document.addEventListener('astro:after-swap', () => {
        attachLangScrollSave();
        const ratio = sessionStorage.getItem('langSwitchRatio');
        if (ratio !== null) {
          sessionStorage.removeItem('langSwitchRatio');
          const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
          const target = Math.round(parseFloat(ratio) * maxScroll);
          window.scrollTo({ left: 0, top: target, behavior: 'instant' });
          // Add the section hash back to the URL without scrolling
          const hash = sessionStorage.getItem('langSwitchHash');
          if (hash) {
            sessionStorage.removeItem('langSwitchHash');
            history.replaceState(history.state, '', location.pathname + '#' + hash);
          }
        }
      });
    </script>
  </body>
</html>
