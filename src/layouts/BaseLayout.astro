  <head>
    <meta charset='UTF-8' />
    <meta
      name='viewport'
      content='width=device-width, initial-scale=1.0'
    />
    <title>{t.site.title}</title>
    <meta
      name='description'
      content={t.site.og_description}
    />

    <meta
      property='og:title'
      content={t.site.title}
    />
    <meta
      property='og:description'
      content={t.site.og_description}
    />
    <meta
      property='og:type'
      content='website'
    />
    <meta
      property='og:locale'
      content={t.site.og_locale}
    />
    <meta
      property='og:site_name'
      content='Manga Café Porto'
    />

    {
      altLocales.map(alt => (
        <link
          rel='alternate'
          hreflang={alt}
          href={getLocalePath(alt)}
        />
      ))
    }

    <link
      rel='preconnect'
      href='https://fonts.googleapis.com'
    />
    <link
      rel='preconnect'
      href='https://fonts.gstatic.com'
      crossorigin
    />
    <link
      href='https://fonts.googleapis.com/css2?family=Alfa+Slab+One&family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Shippori+Mincho:wght@400;500;600&display=swap'
      rel='stylesheet'
    />

    <link
      rel='icon'
      type='image/png'
      sizes='180x180'
      href='/favicon.png'
    />
    <link
      rel='apple-touch-icon'
      href='/favicon.png'
    />

    <script is:inline>
      if (history.state && history.state.scrollX != null) {
        history.replaceState({ ...history.state, scrollX: 0, scrollY: 0 }, '');
      }
      if (location.hash) {
        document.addEventListener('DOMContentLoaded', function () {
          var el = document.querySelector(location.hash);
          if (el) el.scrollIntoView();
        });
      }
    </script>

    <ClientRouter />
  </head>
  <body>
    <div class='page'>
      <a
        href='#main'
        class='sr-only'
        >Skip to content</a
      >
      <LangToggle locale={locale} />
      />
      <Navigation locale={locale} />

      <main id='main'>
        <slot />
      </main>

      <Footer locale={locale} />

      <ScatteredIllustrations />
    </div>

    <script>
      function initReveal() {
        const observer = new IntersectionObserver(
          entries => {
            entries.forEach(entry => {
              if (entry.isIntersecting) {
                entry.target.classList.add('visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.1, rootMargin: '0px 0px -50px 0px' },
        );
        document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
      }

      initReveal();
      document.addEventListener('astro:after-swap', initReveal);
    </script>

    <script>
      import { navigate } from 'astro:transitions/client';

      function attachLangScrollSave() {
        document.querySelectorAll('.lang-option:not(.active)').forEach(link => {
          link.addEventListener('click', e => {
            e.preventDefault();
            const baseHref = (link as HTMLAnchorElement).href.split('#')[0];
            const docHeight = document.documentElement.scrollHeight;
            const ratio = docHeight > window.innerHeight ? window.scrollY / (docHeight - window.innerHeight) : 0;
            const activeTab = document.querySelector('.book-tab.active');
            const sectionId = activeTab?.getAttribute('data-section') || '';
            sessionStorage.setItem('langSwitchRatio', String(ratio));
            if (sectionId) sessionStorage.setItem('langSwitchHash', sectionId);
            navigate(baseHref);
          });
        });
      }

      attachLangScrollSave();
      document.addEventListener('astro:after-swap', () => {
        attachLangScrollSave();
        const ratio = sessionStorage.getItem('langSwitchRatio');
        if (ratio !== null) {
          sessionStorage.removeItem('langSwitchRatio');
          const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
          const target = Math.round(parseFloat(ratio) * maxScroll);
          window.scrollTo({ left: 0, top: target, behavior: 'instant' });
          const hash = sessionStorage.getItem('langSwitchHash');
          if (hash) {
            sessionStorage.removeItem('langSwitchHash');
            history.replaceState(history.state, '', location.pathname + '#' + hash);
          }
        }
      });
    </script>
  </body></html
