---
import Contact from '../../components/Contact.astro';
import EditorialBlurb from '../../components/EditorialBlurb.astro';
import EventsSocial from '../../components/EventsSocial.astro';
import Gallery from '../../components/Gallery.astro';
import Hero from '../../components/Hero.astro';
import MangaLibrary from '../../components/MangaLibrary.astro';
import Menu from '../../components/Menu.astro';
import Pricing from '../../components/Pricing.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const locale = 'ja' as const;
---

<BaseLayout locale={locale}>
  <Hero locale={locale} />
  <EditorialBlurb locale={locale} />
  <Pricing locale={locale} />
  <Menu locale={locale} />
  <MangaLibrary locale={locale} />
  <EventsSocial locale={locale} />
  <Gallery locale={locale} />
  <Contact locale={locale} />
</BaseLayout>
